{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "automerge": false,
  "schedule": [
    "before 5am on Monday and Thursday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "Etc/UTC",
  "enabledManagers": [
    "pip_requirements",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "Python dependencies",
      "separateMajorMinor": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "separateMajorMinor": false
    }
  ]
}